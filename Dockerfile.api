# Petrichor API image (ADR-0102): multi-stage build - Node builds the UI v2
# SPA, then a slim Python 3.15 serves the API and the static assets under
# /ui/. Base images pinned by digest, non-root user, read-only container,
# no network beyond the published port.
FROM node:22.12.0-slim AS ui-build

WORKDIR /build
COPY src/petrichor/api/ui/ ./ui/
WORKDIR /build/ui
RUN npm ci --silent && npm run build
# vite outDir is ../static relative to ui/, so the assets land in /build/static.

FROM python:3.15-slim@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928

RUN groupadd --system petrichor \
    && useradd --system --gid petrichor --home-dir /app --shell /usr/sbin/nologin petrichor

WORKDIR /app

# Install uv to resolve the locked dependencies, then install production deps only.
COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /usr/local/bin/uv
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project
ENV PATH="/app/.venv/bin:$PATH"

# Product source (src layout, ADR-0100), owned by the runtime user.
# No --chmod: default permissions keep the execute bit on directories.
COPY --chown=petrichor:petrichor src/petrichor/ /app/src/petrichor/

# Built UI assets served under /ui/ (ADR-0101), from the Node stage.
COPY --from=ui-build --chown=petrichor:petrichor /build/static/ /app/src/petrichor/api/static/

USER petrichor
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app/src
# ADR-0102: inside the container the API must listen on all interfaces so the
# published port can reach it; locally it stays on loopback (main.py default).
ENV PETRICHOR_HOST=0.0.0.0
EXPOSE 8080
CMD ["python", "-m", "petrichor.main"]
