      <inscription><text>1</text></inscription>
    </arc>
    <arc id="ar_012" source="hasL_3" target="takeR_3">
      <inscription><text>1</text></inscription>
    </arc>
    <arc id="ar_013" source="rel_1" target="fork_1">
