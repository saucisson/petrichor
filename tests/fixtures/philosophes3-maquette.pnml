    </arc>
    <arc id="ar_005" source="fork_1" target="takeR_3">
      <inscription><text>1</text></inscription>
    </arc>
    <arc id="ar_006" source="fork_2" target="takeL_2">
      <inscription><text>1</text></inscription>
    </arc>
    <arc id="ar_007" source="fork_2" target="takeR_1">
      <inscription><text>1</text></inscription>
    </arc>
    <arc id="ar_008" source="fork_3" target="takeL_3">
      <inscription><text>1</text></inscription>
