    </arc>
    <arc id="ar_002" source="eat_2" target="rel_2">
      <inscription><text>1</text></inscription>
    </arc>
    <arc id="ar_003" source="eat_3" target="rel_3">
      <inscription><text>1</text></inscription>
    </arc>
    <arc id="ar_004" source="fork_1" target="takeL_1">
