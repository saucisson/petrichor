<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="model" type="http://www.pnml.org/version-2009/grammar/pnml">
    <place id="eat_1">
      <initialMarking><text>0</text></initialMarking>
    </place>
    <place id="eat_2">
      <initialMarking><text>0</text></initialMarking>
    </place>
    <place id="eat_3">
      <initialMarking><text>0</text></initialMarking>
    </place>
    <place id="fork_1">
      <initialMarking><text>1</text></initialMarking>
    </place>
    <place id="fork_2">
      <initialMarking><text>1</text></initialMarking>
    </place>
    <place id="fork_3">
      <initialMarking><text>1</text></initialMarking>
    </place>
    <place id="hasL_1">
      <initialMarking><text>0</text></initialMarking>
    </place>
    <place id="hasL_2">
      <initialMarking><text>0</text></initialMarking>
    </place>
    <place id="hasL_3">
      <initialMarking><text>0</text></initialMarking>
    </place>
    <place id="think_1">
      <initialMarking><text>1</text></initialMarking>
    </place>
    <place id="think_2">
      <initialMarking><text>1</text></initialMarking>
    </place>
    <place id="think_3">
      <initialMarking><text>1</text></initialMarking>
    </place>
    <transition id="rel_1"/>
    <transition id="rel_2"/>
    <transition id="rel_3"/>
    <transition id="takeL_1"/>
    <transition id="takeL_2"/>
    <transition id="takeL_3"/>
    <transition id="takeR_1"/>
    <transition id="takeR_2"/>
    <transition id="takeR_3"/>
    <arc id="ar_001" source="eat_1" target="rel_1">
