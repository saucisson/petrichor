# Petrichor - example environment file.
# Copy to `.env` and fill in: `.env` is git-ignored, never commit secrets.

# Discord incoming webhook for agent-to-owner notifications (ADR-0012).
# Leave empty to fall back to console delivery (urgent notifications then raise).
DISCORD_WEBHOOK_URL=

# Log rendering: console (local) or json (production) - ADR-0005.
LOG_FORMAT=console

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL - ADR-0005.
LOG_LEVEL=INFO

# Mistral API key for the reviewer agent (ADR-0016). Required in CI as a
# repository secret; optional here for local debugging of agent_review.py.
MISTRAL_API_KEY=

# Reviewing model (ADR-0016/0011: prefer a different family than the
# developer agent). Empty means the script default, mistral-large-latest.
REVIEWER_MODEL=
